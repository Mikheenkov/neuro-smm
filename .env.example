# Скопируйте в .env и заполните. .env не коммитится.

# LLM (основной канал)
ANTHROPIC_WORKSPACE_ID=        # нужен, если ключ организационный (wrkspc_…)
ANTHROPIC_API_KEY=

# Telegram: бот — админ канала
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_AUTHOR_USER_ID=

# MAX Bot API
MAX_BOT_TOKEN=
MAX_CHANNEL_ID=

# Threads: Threads app ID/secret из настроек use case «Access the Threads API»
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=        # заполнит python -m smm.setup_meta threads
THREADS_TOKEN_OBTAINED_AT=
THREADS_USER_ID=

# Facebook Page: App ID/secret приложения Meta (Настройки приложения → Основное)
META_APP_ID=
META_APP_SECRET=
FB_USER_TOKEN=               # короткий токен из Graph API Explorer; setup_meta заменит его
FB_PAGE_ID=                  # заполнит python -m smm.setup_meta facebook
FB_PAGE_TOKEN=

# Stories (фаза 2): api_id/api_hash с my.telegram.org
TG_API_ID=
TG_API_HASH=

# Публичный адрес для картинок Threads (контейнер media через общий Caddy)
SMM_PUBLIC_BASE_URL=https://smm.mikheenkov.com

# Пароль веб-интерфейса браузера на сервере (вход в VK и Facebook)
BROWSER_PASSWORD=
